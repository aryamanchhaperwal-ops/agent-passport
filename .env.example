# AgentPassport local testbed configuration.
# Copy to ".env" if desired; NEVER commit ".env" (already gitignored).

# Which LLM provider agents use: mock | ollama | openrouter
# "mock" needs no external services and is the safe default.
LLM_PROVIDER=mock

# Ollama (local inference, no paid API)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OpenRouter (OPTIONAL cloud provider; leave empty to disable)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Request timeout for network providers (seconds)
LLM_TIMEOUT_SECONDS=30
